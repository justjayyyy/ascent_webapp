# Copy to .env and fill in. See README.md for what each one does.
MONGODB_URI=mongodb://localhost:27017/ascent
JWT_SECRET=
JWT_EXPIRES_IN=7d

VITE_GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:5173
CRON_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

ANTHROPIC_API_KEY=

# Error tracking (Sentry). The same DSN in both; leave empty to turn it off
SENTRY_DSN=
VITE_SENTRY_DSN=
# Optional, at build time: upload source maps for readable stack traces
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
